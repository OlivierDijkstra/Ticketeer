{
  "name": "ticketeer-monorepo",
  "private": true,
  "scripts": {
    "clean": "turbo clean",
    "dev": "turbo dev serve --parallel",
    "serve": "turbo serve",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build": "turbo build"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.2.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}